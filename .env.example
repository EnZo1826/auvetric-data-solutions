# ─── Site ──────────────────────────────────────────────────────────────
# Canonical URL used for metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://example.com
# Only "true" on the production domain. Anything else = robots disallow all.
NEXT_PUBLIC_ALLOW_INDEXING=false
# Public contact address (optional; hidden when unset).
NEXT_PUBLIC_CONTACT_EMAIL=

# ─── Enquiry delivery (server-side only — never prefix with NEXT_PUBLIC_) ───
# "crm" (store in the CRM database; production), "resend" or "webhook". When unset the form returns a clear
# "not enabled" error — it never fakes success.
CONTACT_PROVIDER=
# Resend (https://resend.com) — CONTACT_FROM_EMAIL must be on a verified domain.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Generic webhook (n8n, Node-RED, Power Automate HTTP trigger, etc.)
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=

# ─── Optional Cloudflare Turnstile (abuse prevention) ───────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# ─── CRM (/crm) — server-side only ─────────────────────────────────────
# Postgres. Production: Supabase SESSION pooler (Connect → Session pooler), port 5432, e.g.
#   postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Never the transaction pooler (port 6543): postgres.js hangs through it (the app refuses that URL).
# Local: docker compose -f docker-compose.dev.yml up -d
DATABASE_URL=postgres://auvetric:auvetric_dev@127.0.0.1:54329/auvetric_crm
# Optional: scripts (crm:migrate, crm:user) use this instead of DATABASE_URL when set.
MIGRATE_DATABASE_URL=
# Only for `npm run crm:test:supabase` (Data API lockdown probe). Public values, not secrets.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# 32 random bytes, base64. Seals two-factor secrets at rest. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it invalidates every enrolled authenticator (partners must re-enrol) and the saved mail password.
CRM_ENCRYPTION_KEY=
# Bearer secret shared by /api/crm/cron and the scheduled function netlify/functions/crm-daily.mts (32+ random chars).
CRM_CRON_SECRET=
# Attachments and backups. Production (Netlify) uses Netlify Blobs automatically: leave this UNSET there.
# Local development and CI store files in this folder instead (gitignored).
CRM_FILE_DIR=.crm-files

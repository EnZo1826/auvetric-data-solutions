# ─── Site ──────────────────────────────────────────────────────────────
# Canonical URL used for metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://example.com
# Only "true" on the production domain. Anything else = robots disallow all.
NEXT_PUBLIC_ALLOW_INDEXING=false
# Public contact address (optional; hidden when unset).
NEXT_PUBLIC_CONTACT_EMAIL=

# ─── Enquiry delivery (server-side only — never prefix with NEXT_PUBLIC_) ───
# "resend" or "webhook". When unset the form returns a clear "not enabled" error — it never fakes success.
CONTACT_PROVIDER=
# Resend (https://resend.com) — CONTACT_FROM_EMAIL must be on a verified domain.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Generic webhook (n8n, Node-RED, Power Automate HTTP trigger, etc.)
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=

# ─── Optional Cloudflare Turnstile (abuse prevention) ───────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

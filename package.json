{
  "name": "auvetric-data-solutions",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "node scripts/build-pages.mjs",
    "verify:pages": "node scripts/verify-pages.mjs",
    "verify:brand": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-brand.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify:data": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-demo-data.mjs",
    "verify:telemetry": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-telemetry.mjs",
    "verify:contact": "node scripts/verify-contact.mjs",
    "verify:relay": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-relay.mjs",
    "check": "npm run typecheck && npm run lint && npm run verify:data && npm run verify:telemetry && npm run verify:brand && npm run verify:relay && npm run crm:test:unit && npm run crm:test:calc",
    "crm:db": "docker compose -f docker-compose.dev.yml up -d",
    "crm:migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/crm/migrate.mjs",
    "crm:user": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/crm/user.mjs",
    "crm:test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/crm/test-units.mjs",
    "crm:test:auth": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/crm/test-auth.mjs",
    "crm:test:calc": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/crm/test-calc.mjs",
    "crm:test:api": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/crm/test-api.mjs",
    "crm:test:supabase": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/crm/test-supabase.mjs",
    "crm:test:sales": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/crm/test-sales.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.0",
    "next": "15.5.28",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "three": "^0.186.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.30"
  },
  "engines": {
    "node": ">=22.6"
  }
}

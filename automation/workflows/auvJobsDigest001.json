            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email digest": {
      "main": [
        [
          {
            "node": "One item per job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One item per job": {
      "main": [
        [
          {
            "node": "Mark digested",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run now (localhost webhook)": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Africa/Windhoek",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true
  },
  "pinData": {},

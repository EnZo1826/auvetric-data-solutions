  "nodes": [
    {
      "id": "4d2bed88-548b-49b8-8c9e-1c9753151540",
      "name": "New email in mailbox",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "mailbox": "INBOX",
        "postProcessAction": "nothing",
        "format": "resolved",
        "downloadAttachments": false,
        "options": {
          "customEmailConfig": "[\"UNSEEN\"]",
          "forceReconnect": 30,
          "trackLastMessageId": true
        }
      },
      "credentials": {
        "imap": {
          "id": "auvImapMailbox01",
          "name": "Auvetric mailbox (IMAP)"
        }
      }
    },
    {
      "id": "72cecabd-9dd3-4977-9761-64e0f0443d13",
      "name": "Classify email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "\n// One IMAP trigger for the whole mailbox; classification happens here, not in IMAP search,\n// so behaviour does not depend on the mail server's search implementation.\nconst JOB_DOMAINS = ['upwork.com', 'linkedin.com'];\nconst ENQUIRY_PREFIX = '[auvetric enquiry]';\n// Our own alerts may land in this same mailbox: never re-process them (prevents mail loops).\nconst OWN_ALERT_PREFIXES = ['[auvetric jobs]', '[auvetric lead]'];\nreturn $input.all().map(item => {\n  const j = item.json;\n  const from = String(j.from?.value?.[0]?.address || j.from?.text || '').toLowerCase();\n  const domain = from.split('@')[1] || '';\n  const subject = String(j.subject || '').trim().toLowerCase();\n  const body = String(j.text || '') + String(j.html || '');\n  let route = 'ignore';\n  if (OWN_ALERT_PREFIXES.some(p => subject.startsWith(p))) route = 'ignore';\n  // enquiries must come from the Web3Forms relay or carry the website's AUV1 payload\n  else if (subject.startsWith(ENQUIRY_PREFIX) && (domain === 'web3forms.com' || domain.endsWith('.web3forms.com') || body.includes('AUV1.'))) route = 'enquiry';\n  else if (JOB_DOMAINS.some(d => domain === d || domain.endsWith('.' + d))) route = 'jobs';\n  return { json: { ...j, _route: route }, binary: item.binary };\n});\n"
      }
    },
    {
      "id": "91ecae96-3133-4b80-8337-22c34cd5d3e5",
      "name": "Job alerts",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        440,
        -100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "d67194a7-c17e-4f68-9007-3f3bf2277c60",
              "leftValue": "={{ $json._route }}",
              "rightValue": "jobs",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "7a096ca4-b588-410d-bcd4-d258387d0fbc",

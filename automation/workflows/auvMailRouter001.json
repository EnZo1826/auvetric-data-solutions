          "forceReconnect": 30,
          "trackLastMessageId": true
        }
      },
      "credentials": {
        "imap": {
          "id": "auvImapMailbox01",
          "name": "Auvetric mailbox (IMAP)"
        }
      }
    },
    {
      "id": "7553f3ed-ec29-405d-b745-368eec1b9ba1",
      "name": "Classify email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "\n// One IMAP trigger for the whole mailbox; classification happens here, not in IMAP search,\n// so behaviour does not depend on the mail server's search implementation.\nconst JOB_DOMAINS = ['upwork.com', 'linkedin.com'];\nconst ENQUIRY_PREFIX = '[auvetric enquiry]';\nreturn $input.all().map(item => {\n  const j = item.json;\n  const from = String(j.from?.value?.[0]?.address || j.from?.text || '').toLowerCase();\n  const domain = from.split('@')[1] || '';\n  const subject = String(j.subject || '').trim().toLowerCase();\n  let route = 'ignore';\n  if (subject.startsWith(ENQUIRY_PREFIX)) route = 'enquiry';\n  else if (JOB_DOMAINS.some(d => domain === d || domain.endsWith('.' + d))) route = 'jobs';\n  return { json: { ...j, _route: route }, binary: item.binary };\n});\n"
      }
    },
    {
      "id": "d2018c1d-b6e3-48cf-b9db-4c2b5fc16773",
      "name": "Job alerts",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        440,
        -100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "ac8327f2-61f3-4cb9-b5ff-cba949f9589f",
              "leftValue": "={{ $json._route }}",
              "rightValue": "jobs",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
